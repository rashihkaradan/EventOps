 "client_script": "frappe.ready(function() {\r\n    $('button[data-fieldname=\"buy_now\"]').click(function() {\r\n        frappe.call({\r\n            method: \"final_boss.boss.api.razorpay_integration.create_razorpay_order\",\r\n            args: {\r\n                booking_name: frappe.web_form.get_value(\"name\")\r\n            },\r\n            callback: function(r) {\r\n                if (!r.message) return;\r\n\r\n                var options = {\r\n                    \"key\": frappe.boot.razorpay_key || \"<your_razorpay_key>\",\r\n                    \"amount\": r.message.amount,\r\n                    \"currency\": \"INR\",\r\n                    \"order_id\": r.message.order_id,\r\n                    \"handler\": function(response) {\r\n                        frappe.call({\r\n                            method: \"final_boss.boss.api.razorpay_integration.verify_razorpay_payment\",\r\n                            args: {\r\n                                razorpay_payment_id: response.razorpay_payment_id,\r\n                                razorpay_order_id: response.razorpay_order_id,\r\n                                razorpay_signature: response.razorpay_signature,\r\n                                booking_name: r.message.booking_name\r\n                            }\r\n                        });\r\n                    },\r\n                    \"theme\": {\"color\": \"#528FF0\"}\r\n                };\r\n\r\n                var rzp = new Razorpay(options);\r\n                rzp.open();\r\n            }\r\n        });\r\n    });\r\n});\r\n",
